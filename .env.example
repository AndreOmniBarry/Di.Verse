# Copy to .env and fill in. Never commit .env.

# Live transcription (OpenAI). Without it the app still runs; listening is disabled.
OPENAI_API_KEY=
# Optional: whisper-1 (default) or another OpenAI transcription model your account has
TRANSCRIBE_MODEL=whisper-1

# Scripture detection for implicit quotes + non-KJV verse text (Anthropic)
ANTHROPIC_API_KEY=

PORT=3000

# Licensed translations (NKJV, AMP, NIV, ESV, NLT, MSG...) via API.Bible — https://api.bible
# Free Starter keys are non-commercial only; selling Di.Verse needs a paid plan.
# Check what your key unlocks: npm run check:apibible
APIBIBLE_KEY=
# Optional: pin exact Bible IDs when abbreviations don't match, e.g. NKJV=abc123-01,AMP=def456-01
APIBIBLE_IDS=

# ── AI beta path for translations without licensed text (TPT, NKJV, AMP... ) ──
# Proof-of-concept only — not for a paid release. Any one key enables it;
# two or more lets Di.Verse cross-check wording between providers.
# Gemini (free key: https://aistudio.google.com/apikey) — uses Google Search grounding when your tier allows
GEMINI_API_KEY=
# GEMINI_MODEL=            # optional; otherwise the newest available flash model is picked
# Groq (free key: https://console.groq.com/keys) — groq/compound has web search
GROQ_API_KEY=
# GROQ_MODEL=              # optional; otherwise groq/compound, then a large general model
# ANTHROPIC_API_KEY above is also used as a third opinion; set to false to skip it
# AI_VERSE_USE_CLAUDE=true
