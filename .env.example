# Copy to .env and fill in. Never commit .env.

# Live transcription (OpenAI). Without it the app still runs; listening is disabled.
OPENAI_API_KEY=
# Optional: whisper-1 (default) or another OpenAI transcription model your account has
TRANSCRIBE_MODEL=whisper-1

# Scripture detection for implicit quotes + non-KJV verse text (Anthropic)
ANTHROPIC_API_KEY=

PORT=3000
