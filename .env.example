# Di.Verse settings. Copy this file to .env and fill in what you have.
# Never commit .env or share it. Keys are passwords.
# Full walkthrough: SETUP.md

# ── 1. Groq (FREE): live transcription, AI detection, AI verse checks ──
# Get a key: https://console.groq.com/keys  (no card needed for the free tier)
# Backup keys: separate with commas — the next one takes over if a key hits
# its limit or is rejected, e.g. GROQ_API_KEY=gsk_main,gsk_backup
# (use keys you're entitled to, e.g. a colleague's own account or a paid key;
#  extra free accounts just to dodge limits break the providers' terms)
GROQ_API_KEY=

# ── 2. Gemini (FREE): second opinion for TPT/NKJV/AMP wording ──
# Get a key: https://aistudio.google.com/apikey   (backup keys: comma-separated)
GEMINI_API_KEY=

# ── Optional paid backups (only used if set) ──
# OpenAI: transcription backup when Groq's free limit runs out. Paid from
# prepaid API credit, separate from any ChatGPT Plus subscription.
OPENAI_API_KEY=
# Anthropic: detection + third opinion on verse wording. Paid from API
# credit, separate from any Claude.ai Pro subscription.
ANTHROPIC_API_KEY=

# ── Optional: licensed text instead of AI for NKJV/AMP/NIV... (API.Bible) ──
# Free Starter keys are non-commercial only; a paid release needs a paid plan.
APIBIBLE_KEY=
# Pin exact Bible IDs if abbreviations don't match, e.g. NKJV=abc123-01
APIBIBLE_IDS=

# ── vMix squeeze-back (optional) ──
# In Squeeze mode the camera shrinks into a window and the verse gets a big
# panel. Di.Verse switches vMix to your squeeze scene and back automatically.
# vMix: Settings → Web Controller → enable (port 8088). See SETUP.md.
# VMIX_URL=http://192.168.0.120:8088
# VMIX_SQUEEZE_INPUT=Di.Verse Squeeze
# VMIX_TRANSITION=Fade
# VMIX_DURATION=500

# ── Running the operator page from another computer (optional) ──
# Control normally only works on the Di.Verse laptop itself. Set a token and
# open http://<laptop-ip>:3000/operator?token=<it> on the other computer.
# OPERATOR_TOKEN=

# ── Advanced (leave blank unless you need to change them) ──
# TRANSCRIBE_PROVIDER=groq        # groq or openai — which to try first
# GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_MODEL=whisper-1      # OpenAI transcription model
# GROQ_DETECT_MODEL=              # otherwise picked automatically
# GROQ_MODEL=                     # verse lookups; otherwise groq/compound
# GEMINI_MODEL=                   # otherwise the newest flash model
# AI_VERSE_USE_CLAUDE=true        # false = don't use Claude for verse wording
PORT=3000
