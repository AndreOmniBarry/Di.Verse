# Copy to .env and fill in. Never commit .env.

# Live transcription (OpenAI). Without it the app still runs; listening is disabled.
OPENAI_API_KEY=
# Optional: whisper-1 (default) or another OpenAI transcription model your account has
TRANSCRIBE_MODEL=whisper-1

# Scripture detection for implicit quotes + non-KJV verse text (Anthropic)
ANTHROPIC_API_KEY=

PORT=3000

# Licensed translations (NKJV, AMP, NIV, ESV, NLT, MSG...) via API.Bible — https://api.bible
# Free Starter keys are non-commercial only; selling Di.Verse needs a paid plan.
# Check what your key unlocks: npm run check:apibible
APIBIBLE_KEY=
# Optional: pin exact Bible IDs when abbreviations don't match, e.g. NKJV=abc123-01,AMP=def456-01
APIBIBLE_IDS=
